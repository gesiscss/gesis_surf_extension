{
  "name": "GESIS Surf Extension",
  "version": "2.0.0",
  "description": "GESIS Surf ist eine wissenschaftliche Untersuchung zur Erforschung des Online-Verhaltens der Menschen in Deutschland.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fersonmx/Gesis-Surf/tree/gesisSurf-v2"
  },
  "scripts": {
    "clean": "rimraf dist && rimraf .turbo && turbo clean",
    "build": "turbo build",
    "build:firefox": "cross-env __FIREFOX__=true turbo build",
    "dev-server": "pnpm -F hmr build && pnpm -F hmr dev-server",
    "dev": "concurrently --kill-others \"cross-env __DEV__=true turbo dev --concurrency 20 --filter=!./pages/content-ui --filter=!./pages/devtools-panel\" \"pnpm dev-server\"",
    "dev:firefox": "concurrently --kill-others \"cross-env __DEV__=true __FIREFOX__=true turbo dev --concurrency 20\" \"pnpm dev-server\"",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prettier": "turbo prettier",
    "prepare": "husky",
    "docs": "typedoc"
  },
  "type": "module",
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@types/react-router-dom": "^5.3.3",
    "@types/webextension-polyfill": "^0.12.4",
    "@types/ws": "^8.18.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "idb": "^8.0.0",
    "lint-staged": "^17.0.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.17.0",
    "uuid": "14",
    "webextension-polyfill": "^0.12.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "autoprefixer": "^10.5.0",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "10.5.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1",
    "turbo": "^2.9.18",
    "typedoc": "^0.28.19",
    "typescript": "6.0.3",
    "vite": "^8.0.16"
  },
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=18.12.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  }
}
