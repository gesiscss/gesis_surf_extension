#!/bin/sh

BRANCH=$(git rev-parse --abbrev-ref HEAD)

VALID_PATTERN="^(feature|bugfix|hotfix|refactor|docs|test)/.+$|^(dev|main|prod)$"

if ! echo "$BRANCH" | grep -qE "$VALID_PATTERN"; then
  echo ""
  echo "❌ Branch name '$BRANCH' does not follow the naming convention."
  echo ""
  echo "   Allowed patterns:"
  echo "     feature/<name>   bugfix/<name>   hotfix/<name>"
  echo "     refactor/<name>  docs/<name>     test/<name>"
  echo "     dev  main  prod"
  echo ""
  echo "   Example: git checkout -b feature/my-feature"
  echo ""
  exit 1
fi
